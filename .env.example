# LOCAL: sem credenciais Google. APENAS desenvolvimento, dados em ./data (gitignored)
DATA_BACKEND=local
# PRODUCAO: DATA_BACKEND=google-drive (obrigatorio na Vercel)
# Opção A - OAuth 2.0 do proprietario do Google Drive (possibilita Meu Drive)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Opção B - Conta de servico (SOMENTE Google Shared Drive ou delegacao autorizada)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Pasta EXISTENTE na qual a conta Google autenticada tenha escrita
GOOGLE_DRIVE_FOLDER_ID=
# OBRIGATORIO em produção. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# OBRIGATORIO em produção; protege o primeiro administrador. Nunca publique.
ADMIN_SETUP_TOKEN=
# Opcional, URL publicada para links DISC (por padrao usa a origem da solicitacao)
PUBLIC_BASE_URL=
# Opcional: escolher porta no Windows/dev
PORT=3000
